<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFC">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="100dp">

            <!-- 1. TOP BAR (Back button, Title, Dictionary Switcher) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Back button -->
                <FrameLayout
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_icon"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/btn_back"
                        android:src="@drawable/ic_arrow_back" />
                </FrameLayout>

                <!-- Title & Subtitle -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_lookup_instant"
                        android:textColor="#0F172A"
                        android:textSize="16.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/subtitle_lookup_instant"
                        android:textColor="#64748B"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Dictionary Selector Switcher -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_dict_switch"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <!-- Option 1: Tất cả (Active) -->
                    <LinearLayout
                        android:id="@+id/tabDictAll"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_dict_active"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_globe" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="0dp"
                            android:text="Tất\ncả"
                            android:textColor="#FFFFFF"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Option 2: GB Anh -->
                    <TextView
                        android:id="@+id/tabDictEn"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:lineSpacingExtra="0dp"
                        android:paddingHorizontal="8dp"
                        android:text="@string/dict_gb_short"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <!-- Option 3: JP Nhật -->
                    <TextView
                        android:id="@+id/tabDictJp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:lineSpacingExtra="0dp"
                        android:paddingHorizontal="8dp"
                        android:text="@string/dict_jp_short"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. SEARCH BOX -->
            <LinearLayout
                android:id="@+id/searchContainer"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_search_bar"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/etSearchBox"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/hint_search_lookup"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:textColor="#1E293B"
                    android:textColorHint="#94A3B8"
                    android:textSize="13.5sp" />

                <!-- Voice Search Button -->
                <FrameLayout
                    android:id="@+id/btnVoiceSearch"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_tip_box"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_mic" />
                </FrameLayout>

                <!-- Camera / OCR Search Button -->
                <FrameLayout
                    android:id="@+id/btnCameraSearch"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_tip_box"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_camera" />
                </FrameLayout>
            </LinearLayout>

            <!-- 3. WORD TYPE FILTER CHIPS -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Filter: Tất cả (Active) -->
                    <TextView
                        android:id="@+id/chipFilterAll"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_chip_purple"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:text="@string/filter_all"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Filter: Danh từ -->
                    <TextView
                        android:id="@+id/chipFilterNoun"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_white"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:text="@string/filter_noun"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Filter: Động từ -->
                    <TextView
                        android:id="@+id/chipFilterVerb"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_white"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:text="@string/filter_verb"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Filter: Tính từ -->
                    <TextView
                        android:id="@+id/chipFilterAdj"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_white"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:text="@string/filter_adj"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Filter: Idiom -->
                    <TextView
                        android:id="@+id/chipFilterIdiom"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_white"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:text="@string/filter_idiom"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 4. RECENT SEARCHES ("Tra cứu gần đây") -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_clock" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/title_recent_search"
                    android:textColor="#64748B"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnClearHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/btn_clear_history"
                    android:textColor="#6339E9"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Recent search chips: Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipRecent1"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_chip_white"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="Serendipity"
                    android:textColor="#1E293B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipRecent2"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_white"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="Idempotent"
                    android:textColor="#1E293B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipRecent3"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_white"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="Ephemeral"
                    android:textColor="#1E293B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipRecent4"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_white"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="Pragmatic"
                    android:textColor="#1E293B"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Recent search chips: Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipRecent5"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_chip_white"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="Ubiquitous"
                    android:textColor="#1E293B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipRecent6"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_white"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="Resilience"
                    android:textColor="#1E293B"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 5. INVENTORY HEADER ("Tất cả từ vựng trong kho (8)") -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/title_inventory_count"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnAddNewWord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/btn_add_new_word_inventory"
                    android:textColor="#6339E9"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- WORD CARD 1: Serendipity -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_stat_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Word & Actions -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Serendipity"
                            android:textColor="#0F172A"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="/ˌser.ənˈdɪp.ə.ti/"
                            android:textColor="#64748B"
                            android:textSize="13sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <!-- Audio Button -->
                        <FrameLayout
                            android:id="@+id/btnAudioWord1"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_audio_circle"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_speaker_purple" />
                        </FrameLayout>

                        <!-- Bookmark Button -->
                        <ImageView
                            android:id="@+id/btnBookmarkWord1"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="10dp"
                            android:clickable="true"
                            android:contentDescription="@null"
                            android:focusable="true"
                            android:src="@drawable/ic_bookmark_gold" />
                    </LinearLayout>

                    <!-- Badges -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_purple"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="@string/badge_noun"
                            android:textColor="#6339E9"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_badge_purple"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="@string/badge_c1"
                            android:textColor="#6339E9"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Meaning -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Sự tình cờ may mắn; khả năng phát hiện ra những điều thú vị, có giá trị một cách ngẫ…"
                        android:textColor="#334155"
                        android:textSize="13.5sp" />

                    <!-- Note Tip -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_pencil" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/tip_mnemonic_wotd"
                            android:textColor="#6339E9"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- WORD CARD 2: Resilient -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_stat_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Word & Badges & Actions -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/word_resilient"
                            android:textColor="#0F172A"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/phonetic_resilient"
                            android:textColor="#64748B"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_badge_purple"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="@string/badge_adj"
                            android:textColor="#6339E9"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <!-- Audio Button -->
                        <FrameLayout
                            android:id="@+id/btnAudioWord2"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_audio_circle"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_speaker_purple" />
                        </FrameLayout>

                        <!-- Bookmark Button -->
                        <ImageView
                            android:id="@+id/btnBookmarkWord2"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="10dp"
                            android:clickable="true"
                            android:contentDescription="@null"
                            android:focusable="true"
                            android:src="@drawable/ic_bookmark_gold" />
                    </LinearLayout>

                    <!-- CEFR Badge B2 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_purple"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="@string/badge_b2"
                            android:textColor="#6339E9"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Meaning -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/meaning_resilient"
                        android:textColor="#334155"
                        android:textSize="13.5sp" />

                    <!-- Note Tip -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_pencil" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/tip_resilient"
                            android:textColor="#6339E9"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- WORD CARD 3: Idempotent -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_stat_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Word & Actions -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/word_idempotent"
                            android:textColor="#0F172A"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/phonetic_idempotent"
                            android:textColor="#64748B"
                            android:textSize="13sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <!-- Audio Button -->
                        <FrameLayout
                            android:id="@+id/btnAudioWord3"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_audio_circle"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_speaker_purple" />
                        </FrameLayout>

                        <!-- Bookmark Button -->
                        <ImageView
                            android:id="@+id/btnBookmarkWord3"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="10dp"
                            android:clickable="true"
                            android:contentDescription="@null"
                            android:focusable="true"
                            android:src="@drawable/ic_bookmark_gold" />
                    </LinearLayout>

                    <!-- Badges -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_purple"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="@string/badge_adj"
                            android:textColor="#6339E9"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_badge_purple"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="@string/badge_c2"
                            android:textColor="#6339E9"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Meaning -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/meaning_idempotent"
                        android:textColor="#334155"
                        android:textSize="13.5sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 6. BOTTOM NAVIGATION BAR (6 TABS, TAB 2 TRA CỨU ACTIVE) -->
    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Tab 1: Trang chủ -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/nav_home"
                android:src="@drawable/ic_compass"
                app:tint="#94A3B8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_home"
                android:textColor="#64748B"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Tab 2: Tra cứu (Active) -->
        <LinearLayout
            android:id="@+id/navLookup"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_badge_purple">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/nav_lookup"
                    android:src="@drawable/ic_nav_search" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_lookup"
                android:textColor="#6339E9"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 3: Sổ tay -->
        <LinearLayout
            android:id="@+id/navNotebook"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/nav_notebook"
                android:src="@drawable/ic_nav_notebook" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_notebook"
                android:textColor="#64748B"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Tab 4: Ôn SM-2 -->
        <LinearLayout
            android:id="@+id/navSRS"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/nav_srs"
                android:src="@drawable/ic_nav_srs" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_srs"
                android:textColor="#64748B"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Tab 5: Thống kê -->
        <LinearLayout
            android:id="@+id/navStats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/nav_stats"
                android:src="@drawable/ic_nav_stats" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_stats"
                android:textColor="#64748B"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Tab 6: Tài khoản -->
        <LinearLayout
            android:id="@+id/navAccount"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/nav_account"
                android:src="@drawable/ic_nav_account" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_account"
                android:textColor="#64748B"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>