<?xml version="1.0" encoding="utf-8"?>
<!-- [THÊM]: Item layout cho danh sách từ vựng trong sổ tay NotebookActivity theo PROMPT 6.2 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_vocab_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Row: Word + Type Tag + Status Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvWord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#1F2937"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Serendipity" />

        <TextView
            android:id="@+id/badgePos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_menu_badge_ocr"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="#6339E9"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Danh từ" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Status Badge -->
        <LinearLayout
            android:id="@+id/layoutStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_learning"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp">

            <ImageView
                android:id="@+id/ivStatusIcon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="status icon"
                android:src="@drawable/ic_hourglass" />

            <TextView
                android:id="@+id/tvStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="#D97706"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Đang học" />
        </LinearLayout>
    </LinearLayout>

    <!-- Phonetic / IPA -->
    <TextView
        android:id="@+id/tvPhonetic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="#6B7280"
        android:textSize="12.5sp"
        tools:text="/ˌser.ənˈdɪp.ə.ti/" />

    <!-- Meaning Text -->
    <TextView
        android:id="@+id/tvMeaning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2dp"
        android:textColor="#4B5563"
        android:textSize="13sp"
        tools:text="Sự tình cờ may mắn; khả năng tình cờ phát hiện ra những điều thú vị." />

    <!-- Footer Row: Topic Label + SRS Review Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivTopicIcon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="topic icon"
            android:src="@drawable/ic_graduation_cap"
            app:tint="#6B7280" />

        <TextView
            android:id="@+id/tvTopicText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:textColor="#6B7280"
            android:textSize="11sp"
            tools:text="IELTS Reading &amp; Academic" />

        <TextView
            android:id="@+id/tvReviewInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#9CA3AF"
            android:textSize="11sp"
            tools:text="Ôn tập sau: 3 ngày" />
    </LinearLayout>
</LinearLayout>
